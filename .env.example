# Copy to .env (local) or create ~/td-global/.env on the server. Never commit .env.

APP_NAME="TD Global Clearing & Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The address people type. On the server: https://your-domain
APP_URL=http://localhost:8000
# Canonical address used in links, the sitemap and structured data (leave empty to use APP_URL).
SITE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

# ── Database ──────────────────────────────────────────────────────────────
# Local: SQLite (nothing to set up). On shared hosting: create a MySQL database and user in cPanel, then
# set DB_CONNECTION=mysql and fill in the four values below.
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Sessions and the rate limiter live in the database, so no extra services are needed on shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
# Messages after a form are sent right after the response (no queue worker needed).
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ── Email (tracking numbers, status updates, reminders, contact form) ─────────────────────────────
# MAIL_MAILER=log writes emails to storage/logs instead of sending them, and the staff screens then show
# "Email skipped (not set up)". For real mail use SMTP: your host's mail server, Brevo (free 300/day) or
# Resend (smtp.resend.com, port 465, user "resend", password = API key). The sender address must be on a
# domain you have verified with that provider.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="updates@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Contact and quote forms ──────────────────────────────────────────────────
# Optional: send submissions to a webhook (Formspree, Make, Zapier...) instead of by email.
FORM_WEBHOOK_URL=

# ── Telegram bot (optional; see README → Telegram) ─────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 16-256 letters, digits, _ or -  (for example: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Staff alert group: add the bot to the group, send /chatid, paste the number it answers with.
TELEGRAM_STAFF_CHAT_ID=

# ── Search engines (optional) ────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
